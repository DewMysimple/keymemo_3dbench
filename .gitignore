# standalone repository.
blender/*.blend1
blender/*.blend2
generated/*
reports/rendered/
versions/*/generated/*
versions/*/reports/rendered/
versions/*/blender/*.blend1
versions/*/blender/*.blend2
blender_modelbench/**/*.blend1
blender_modelbench/**/*.blend2

